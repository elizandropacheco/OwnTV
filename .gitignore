# Private editable brand masters must never be published.
/art/owntv/
/app/src/main/assets/ep/logo.png
*.psd
*.ai
*.xcf
*.cdr

# Local tooling caches
.tools/
__pycache__/
*.py[cod]

# webOS release binaries are distributed separately.
/releases/**/*.ipk

# Full HD photographs are generated from the credited Android catalog.
/webos/app/assets/wallpapers/*.jpg

/webos/service/private-data/
/webos/bridge/*private*.json

webos/node_modules/
**/__pycache__/
